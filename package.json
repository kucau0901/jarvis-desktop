{
  "name": "jarvis-desktop",
  "productName": "Jarvis",
  "version": "0.1.0",
  "description": "Jarvis on the desktop: your own Jarvis in a window, with alerts, a talk shortcut and file drop.",
  "license": "MIT",
  "repository": "github:kucau0901/jarvis-desktop",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/*.test.ts",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.0.0",
    "typescript": "^5.9.0"
  },
  "build": {
    "appId": "app.jarvis.desktop",
    "productName": "Jarvis",
    "directories": { "output": "release", "buildResources": "build" },
    "files": ["dist/**/*", "setup/**/*", "assets/**/*", "package.json"],
    "publish": { "provider": "github", "releaseType": "release" },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }],
      "identity": "-",
      "hardenedRuntime": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Jarvis listens when you talk to it.",
        "NSCameraUsageDescription": "Jarvis takes a photo when you attach one to a question.",
        "NSAppleEventsUsageDescription": "Jarvis asks other apps to do things when you ask it to use this Mac.",
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "File",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": ["public.item"]
          }
        ]
      }
    },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
